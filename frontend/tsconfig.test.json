{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2022",
    "lib": ["DOM", "ES2022"],
    "types": ["node"],
    "customConditions": [],
    "outDir": ".test-build",
    "rootDir": ".",
    "incremental": false,
    "jsx": "react-jsx"
  },
  "include": [
    "src/config/**/*.ts",
    "src/services/**/*.ts",
    "src/types/globals.d.ts",
    "src/utils/**/*.ts",
    "tests/unit/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", ".test-build", "src/services/api.ts", "src/services/session/platform.ts"]
}
