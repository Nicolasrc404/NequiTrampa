# ============================================================
# NequiTrampa — variables públicas de Expo (EXPO_PUBLIC_*)
# ============================================================
# Copia este archivo como `.env` en desarrollo.
#
# IMPORTANTE: todo lo declarado con EXPO_PUBLIC_* queda embebido en el bundle
# y es legible por cualquiera que inspeccione la app. NUNCA coloques aquí
# secretos, claves privadas, tokens de servicio ni credenciales.

# URL base del API Gateway (sin barra final). En local, el gateway escucha en
# el puerto configurado por su launchSettings; en despliegue usa el host de
# Cloud Run. Si se omite, la app funciona en modo DEMO sin red.
EXPO_PUBLIC_API_URL=http://localhost:8080

# Modo DEMO: `true` (por defecto en `__DEV__`) | `false`.
# Solo puede activarse en builds de desarrollo; en producción se ignora.
EXPO_PUBLIC_DEMO_MODE=true

# Timeout de la capa HTTP en milisegundos (3000–60000, por defecto 15000).
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# Web API key de Identity Platform (pública, va en el bundle).
# Se obtiene del proyecto full-stack-2026. NUNCA es un secreto de servidor.
# Si se omite, la app no puede iniciar sesión ni refrescar tokens.
EXPO_PUBLIC_IDENTITY_API_KEY=
