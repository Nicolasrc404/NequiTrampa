meta {
  name: Create Report Invalid Range
  type: http
  seq: 13
}

post {
  url: {{workersUrl}}/v1/reports
  body: json
  auth: none
}

headers {
  X-Persona: client
  Idempotency-Key: {{reportIdempotencyKey}}
}

body:json {
  { "from": "2026-12-31", "to": "2026-01-01" }
}

script:pre-request {
  const uuid = require("uuid");
  bru.setVar("reportIdempotencyKey", uuid.v4());
}

assert {
  res.status: eq 422
  res.body.code: eq invalid_range
}
