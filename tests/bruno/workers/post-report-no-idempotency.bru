meta {
  name: Create Report No Idempotency
  type: http
  seq: 12
}

post {
  url: {{workersUrl}}/v1/reports
  body: json
  auth: none
}

headers {
  X-Persona: client
}

body:json {
  { "from": "2026-01-01", "to": "2026-12-31" }
}

assert {
  res.status: eq 400
  res.body.code: eq idempotency_key_required
}
