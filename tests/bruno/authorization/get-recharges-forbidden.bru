meta {
  name: Get Recharges Forbidden (role SOPORTE)
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/v1/recharges
  body: none
  auth: none
}

headers {
  X-Serverless-Authorization: Bearer {{serverlessToken}}
  X-Demo-User: support-agent-1
  X-Demo-Role: SOPORTE
}

assert {
  res.status: eq 403
}