meta {
  name: Support Case Escalate
  type: http
  seq: 23
}

post {
  url: {{backofficeUrl}}/v1/support/cases/{{caseId}}/escalations
  body: json
  auth: none
}

headers {
  X-Persona: support
}

body:json {
  { "reason": "Requiere revisión del operador financiero" }
}

assert {
  res.status: eq 201
  res.body.status: eq ESCALATED
  res.body.escalationLevel: eq 1
}
