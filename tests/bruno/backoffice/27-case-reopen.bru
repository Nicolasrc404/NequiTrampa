meta {
  name: Support Case Reopen (409)
  type: http
  seq: 27
}

patch {
  url: {{backofficeUrl}}/v1/support/cases/{{caseId}}/status
  body: json
  auth: none
}

headers {
  X-Persona: support
}

body:json {
  { "status": "OPEN" }
}

assert {
  res.status: eq 409
  res.body.code: eq case_closed
}
