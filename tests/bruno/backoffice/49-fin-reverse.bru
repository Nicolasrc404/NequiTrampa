meta {
  name: Fin: Create Reversal
  type: http
  seq: 49
}

post {
  url: {{backofficeUrl}}/v1/financial-operations/{{finOpId}}/reversals
  body: json
  auth: none
}

headers {
  X-Persona: operator
  Idempotency-Key: {{reversalKey}}
}

body:json {
  { "reason": "Reverso de prueba automatizada" }
}

script:pre-request {
  const uuid = require("uuid");
  bru.setVar("reversalKey", uuid.v4());
}

script:post-response {
  if (res.getStatus() === 201) { bru.setVar("reversalRef", res.body.publicReference); bru.setVar("reversalOpId", res.body.operationId); }
}

assert {
  res.status: eq 201
  res.body.type: eq REVERSAL
  res.body.status: eq COMPLETED
}
