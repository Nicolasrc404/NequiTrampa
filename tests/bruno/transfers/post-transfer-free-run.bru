meta {
  name: Post Transfer Free Run (MANUAL NEW MOVEMENT)
  type: http
  seq: 19
  tags: [
    manual
    stateful
  ]
}

post {
  url: {{baseUrl}}/v1/transfers
  body: json
  auth: none
}

headers {
  X-Serverless-Authorization: Bearer {{serverlessToken}}
  X-Demo-User: {{clientUser}}
  X-Demo-Role: {{clientRole}}
  Idempotency-Key: {{freeRunTransferKey}}
}

body:json {
  {
    "destinationTransferCode": "{{destCode}}",
    "amount": 25000,
    "description": "Movimiento libre",
    "currency": "COP"
  }
}

script:pre-request {
  const uuid = require("uuid");
  bru.setVar("freeRunTransferKey", uuid.v4());
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("lastTransferId", res.body.transferId);
  }
}

assert {
  res.status: eq 201
  res.body.currency: eq COP
  res.body.status: eq COMPLETED
}

docs {
  FREE-RUN. Cada ejecucion genera una Idempotency-Key nueva, por lo que SIEMPRE crea un
  movimiento financiero nuevo: nunca es replay y consume cupo diario.

  Esta fuera de la corrida por defecto mediante los tags manual/stateful.
  No forma parte de la suite automatizada por diseno.
}