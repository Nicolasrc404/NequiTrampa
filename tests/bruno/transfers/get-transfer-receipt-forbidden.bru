meta {
  name: Get Transfer Receipt Forbidden (other client)
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/v1/transfers/{{lastTransferId}}/receipt
  body: none
  auth: none
}

headers {
  X-Serverless-Authorization: Bearer {{serverlessToken}}
  X-Demo-User: {{clientUser2}}
  X-Demo-Role: {{clientRole}}
}

script:pre-request {
  const known = bru.getEnvVar("knownTransferId");
  if (known) bru.setVar("lastTransferId", known);
}

assert {
  res.status: eq 403
  res.body.code: eq FORBIDDEN
}
