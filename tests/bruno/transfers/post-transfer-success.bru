meta {
  name: Post Transfer Success
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/transfers
  body: json
  auth: none
}

headers {
  X-Serverless-Authorization: Bearer {{serverlessToken}}
  X-Demo-User: {{clientUser}}
  X-Demo-Role: {{clientRole}}
  Idempotency-Key: {{transferDemoKey}}
}

body:json {
  {
    "destinationTransferCode": "{{destCode}}",
    "amount": 25000,
    "description": "Pago almuerzo",
    "currency": "COP"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("lastTransferId", res.body.transferId);
  }
}

assert {
  res.status: eq 201
  res.body.currency: eq COP
  res.body.status: eq COMPLETED
}
