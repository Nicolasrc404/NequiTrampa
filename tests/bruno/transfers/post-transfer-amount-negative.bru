meta {
  name: Post Transfer Amount Negative (DTO Range)
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/v1/transfers
  body: json
  auth: none
}

headers {
  X-Serverless-Authorization: Bearer {{serverlessToken}}
  X-Demo-User: {{clientUser}}
  X-Demo-Role: {{clientRole}}
  Idempotency-Key: {{negAmountNegativeKey}}
}

body:json {
  {
    "destinationTransferCode": "{{destCode}}",
    "amount": -5000,
    "description": "Monto negativo: viola Range(1, 2000000)",
    "currency": "COP"
  }
}

script:pre-request {
  const uuid = require("uuid");
  bru.setVar("negAmountNegativeKey", uuid.v4());
}

assert {
  res.status: eq 422
  res.body.code: eq VALIDATION_ERROR
}

tests {
  test("El error señala el campo amount", function() {
    expect(Object.keys(res.body.invalidParams || {}).join()).to.include("Amount");
  });
}