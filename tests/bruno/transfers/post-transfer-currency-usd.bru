meta {
  name: Post Transfer Currency Not COP (DTO regexp)
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/v1/transfers
  body: json
  auth: none
}

headers {
  X-Serverless-Authorization: Bearer {{serverlessToken}}
  X-Demo-User: {{clientUser}}
  X-Demo-Role: {{clientRole}}
  Idempotency-Key: {{negCurrencyKey}}
}

body:json {
  {
    "destinationTransferCode": "{{destCode}}",
    "amount": 25000,
    "description": "Moneda no autorizada",
    "currency": "USD"
  }
}

script:pre-request {
  const uuid = require("uuid");
  bru.setVar("negCurrencyKey", uuid.v4());
}

assert {
  res.status: eq 422
  res.body.code: eq VALIDATION_ERROR
}

tests {
  test("El error señala el campo Currency", function() {
    expect(Object.keys(res.body.invalidParams || {}).join()).to.include("Currency");
  });
}