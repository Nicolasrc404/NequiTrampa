meta {
  name: Post Transfer Destination Malformed (DTO regexp)
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/v1/transfers
  body: json
  auth: none
}

headers {
  X-Serverless-Authorization: Bearer {{serverlessToken}}
  X-Demo-User: {{clientUser}}
  X-Demo-Role: {{clientRole}}
  Idempotency-Key: {{negMalformedDestKey}}
}

body:json {
  {
    "destinationTransferCode": "TRF LAU 0002!",
    "amount": 25000,
    "description": "Codigo con espacios y signos: viola ^[A-Za-z0-9_-]+$",
    "currency": "COP"
  }
}

script:pre-request {
  const uuid = require("uuid");
  bru.setVar("negMalformedDestKey", uuid.v4());
}

assert {
  res.status: eq 422
  res.body.code: eq VALIDATION_ERROR
}

tests {
  test("El error señala el campo DestinationTransferCode", function() {
    expect(Object.keys(res.body.invalidParams || {}).join()).to.include("DestinationTransferCode");
  });
}