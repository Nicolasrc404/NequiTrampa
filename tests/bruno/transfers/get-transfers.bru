meta {
  name: Get Transfers List
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/v1/transfers?page=1&pageSize=20
  body: none
  auth: none
}

headers {
  X-Serverless-Authorization: Bearer {{serverlessToken}}
  X-Demo-User: {{clientUser}}
  X-Demo-Role: {{clientRole}}
}

assert {
  res.status: eq 200
}
