meta {
  name: Post Recharge Invalid Payment Method (DTO regexp)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/v1/recharges
  body: json
  auth: none
}

headers {
  X-Serverless-Authorization: Bearer {{serverlessToken}}
  X-Demo-User: {{clientUser}}
  X-Demo-Role: {{clientRole}}
  Idempotency-Key: {{negRechargeMethodKey}}
}

body:json {
  {
    "amount": 50000,
    "paymentMethod": "PAYPAL",
    "currency": "COP"
  }
}

script:pre-request {
  const uuid = require("uuid");
  bru.setVar("negRechargeMethodKey", uuid.v4());
}

assert {
  res.status: eq 422
  res.body.code: eq VALIDATION_ERROR
}

tests {
  test("El error señala el campo PaymentMethod", function() {
    expect(Object.keys(res.body.invalidParams || {}).join()).to.include("PaymentMethod");
  });
}