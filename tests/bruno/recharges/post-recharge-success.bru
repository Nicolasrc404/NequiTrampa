meta {
  name: Post Recharge Success
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/recharges
  body: json
  auth: none
}

headers {
  X-Demo-User: {{clientUser}}
  X-Demo-Role: {{clientRole}}
  Idempotency-Key: idemp-rcg-001
}

body:json {
  {
    "amount": 50000,
    "paymentMethod": "SIMULATED_PSE",
    "currency": "COP"
  }
}

assert {
  res.status: eq 201
  res.body.currency: eq COP
  res.body.status: eq COMPLETED
}
