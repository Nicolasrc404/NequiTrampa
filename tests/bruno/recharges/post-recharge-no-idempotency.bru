meta {
  name: Post Recharge No Idempotency Key
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/recharges
  body: json
  auth: none
}

headers {
  X-Persona: client
}

body:json {
  {
    "amount": 50000,
    "paymentMethod": "SIMULATED_PSE",
    "currency": "COP"
  }
}

assert {
  res.status: eq 400
  res.body.code: eq idempotency_key_required
}
