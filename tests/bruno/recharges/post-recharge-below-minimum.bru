meta {
  name: Post Recharge Below Minimum (DTO Range)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/recharges
  body: json
  auth: none
}

headers {
  X-Serverless-Authorization: Bearer {{serverlessToken}}
  X-Demo-User: {{clientUser}}
  X-Demo-Role: {{clientRole}}
  Idempotency-Key: {{negRechargeMinKey}}
}

body:json {
  {
    "amount": 999,
    "paymentMethod": "SIMULATED_PSE",
    "currency": "COP"
  }
}

script:pre-request {
  const uuid = require("uuid");
  bru.setVar("negRechargeMinKey", uuid.v4());
}

assert {
  res.status: eq 422
  res.body.code: eq VALIDATION_ERROR
}

tests {
  test("El error señala el campo Amount", function() {
    expect(Object.keys(res.body.invalidParams || {}).join()).to.include("Amount");
  });
}