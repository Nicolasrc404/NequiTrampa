meta {
  name: Post Recharge Free Run (MANUAL NEW MOVEMENT)
  type: http
  seq: 10
  tags: [
    manual
    stateful
  ]
}

post {
  url: {{baseUrl}}/v1/recharges
  body: json
  auth: none
}

headers {
  X-Serverless-Authorization: Bearer {{serverlessToken}}
  X-Demo-User: {{clientUser}}
  X-Demo-Role: {{clientRole}}
  Idempotency-Key: {{freeRunRechargeKey}}
}

body:json {
  {
    "amount": 50000,
    "paymentMethod": "SIMULATED_PSE",
    "currency": "COP"
  }
}

script:pre-request {
  const uuid = require("uuid");
  bru.setVar("freeRunRechargeKey", uuid.v4());
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("lastRechargeId", res.body.rechargeId);
  }
}

assert {
  res.status: eq 201
  res.body.currency: eq COP
  res.body.status: eq COMPLETED
}

docs {
  FREE-RUN. Cada ejecucion genera una Idempotency-Key nueva, por lo que SIEMPRE acredita
  saldo de nuevo: nunca es replay.

  Esta fuera de la corrida por defecto mediante los tags manual/stateful.
  No forma parte de la suite automatizada por diseno.
}