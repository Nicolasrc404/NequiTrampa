meta {
  name: Post Recharge Replay Same Key Same Body
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/v1/recharges
  body: json
  auth: none
}

headers {
  X-Serverless-Authorization: Bearer {{serverlessToken}}
  X-Demo-User: {{clientUser}}
  X-Demo-Role: {{clientRole}}
  Idempotency-Key: {{rechargeDemoKey}}
}

body:json {
  {
    "amount": 50000,
    "paymentMethod": "SIMULATED_PSE",
    "currency": "COP"
  }
}

assert {
  res.status: eq 201
}

tests {
  test("Idempotent replay header is true", function() {
    const headers = res.getHeaders();

    const replayHeader = Array.isArray(headers)
      ? headers.find(([name]) =>
          String(name).toLowerCase() === "idempotent-replayed"
        )?.[1]
      : Object.entries(headers || {}).find(([name]) =>
          String(name).toLowerCase() === "idempotent-replayed"
        )?.[1];

    expect(String(replayHeader).toLowerCase()).to.equal("true");
  });

  test("Replay devuelve la misma recarga y no duplica fondos", function() {
    expect(res.body.rechargeId).to.equal(bru.getVar("lastRechargeId"));
  });
}

docs {
  El cuerpo debe ser identico byte a byte al de post-recharge-success.bru:
  el idempotency store compara el SHA-256 de los bytes crudos del body.
}