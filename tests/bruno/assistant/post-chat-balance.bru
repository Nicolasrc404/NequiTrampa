meta {
  name: Assistant Chat (saldo)
  type: http
  seq: 4
}

post {
  url: {{assistantUrl}}/v1/assistant/chat
  body: json
  auth: none
}

headers {
  X-Persona: client
}

body:json {
  { "message": "¿Cuál es mi saldo?" }
}

assert {
  res.status: eq 200
  res.body.answer: isString
  res.body.summary.balanceCents: gt 0
}
