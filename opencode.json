{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "stitch": {
            "type": "local",
            "command": [
                "cmd",
                "/c",
                "stitch",
                "mcp",
                "start"
            ],
            "enabled": true,
            "timeout": 300000
        }
    },
    "permission": {
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "lsp": "allow",
        "bash": {
            "*": "ask",
            "git status *": "allow",
            "git diff *": "allow",
            "git log *": "allow",
            "git branch *": "allow",
            "git push *": "deny",
            "git reset *": "deny",
            "git clean *": "deny"
        }
    },
    "agent": {
        "build": {
            "permission": {
                "read": "allow",
                "edit": "allow",
                "glob": "allow",
                "grep": "allow",
                "lsp": "allow"
            }
        }
    }
}